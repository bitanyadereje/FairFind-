<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>FairFind – Ethiopian Marketplace Search</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        /* ----- Reset & base ----- */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f6faff;
            color: #0b1d3a;
            -webkit-font-smoothing: antialiased;
            padding: 0 1rem;
        }

        /* ----- Container ----- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 0 3rem;
        }

        /* ----- Header ----- */
        .header {
            text-align: center;
            padding: 2rem 0 1.5rem;
        }
        .header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            color: #0b2b6b;
            letter-spacing: -0.02em;
        }
        .header p {
            font-size: 1.1rem;
            color: #3a5780;
            margin-top: 0.2rem;
        }

        /* ----- Search card ----- */
        .search-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0, 20, 60, 0.08);
            padding: 1.5rem 1.25rem;
            margin-bottom: 2.5rem;
            border: 1px solid #e4ecf7;
        }

        .search-form {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        @media (min-width: 640px) {
            .search-form {
                flex-direction: row;
                align-items: flex-end;
                gap: 1rem;
            }
            .search-field { flex: 1; }
        }

        .search-field label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #1a3b6b;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.4rem;
        }

        .search-field input {
            width: 100%;
            border: 1.5px solid #dce7f5;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            font-size: 1rem;
            background: #f9fcff;
            transition: 0.15s ease;
            color: #0b1d3a;
        }

        .search-field input:focus {
            outline: none;
            border-color: #2e6bcf;
            background: #ffffff;
            box-shadow: 0 0 0 4px #dce7f9;
        }

        .search-field input::placeholder {
            color: #96abc9;
        }

        .search-btn {
            background: #1a4b8c;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            border: none;
            border-radius: 12px;
            padding: 0.9rem 2rem;
            cursor: pointer;
            transition: background 0.15s ease;
            white-space: nowrap;
            min-height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .search-btn:hover {
            background: #0f3a70;
        }

        /* ----- Results header ----- */
        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid #e4ecf7;
        }

        .results-header h2 {
            font-size: 1.4rem;
            font-weight: 600;
            color: #0b1d3a;
        }

        .results-header h2 .highlight {
            color: #1a4b8c;
        }

        .results-header .count {
            font-size: 0.9rem;
            color: #4e6e96;
        }

        /* ----- Empty state ----- */
        .empty-state {
            background: #ffffff;
            border-radius: 20px;
            padding: 3rem 1.5rem;
            text-align: center;
            border: 1px dashed #cbdae9;
        }
        .empty-state .icon {
            font-size: 3rem;
            margin-bottom: 0.75rem;
        }
        .empty-state p {
            font-size: 1rem;
            color: #3a5780;
            max-width: 400px;
            margin: 0 auto;
        }
        .empty-state .hint {
            font-size: 0.9rem;
            color: #7b94b5;
            margin-top: 0.4rem;
        }

        /* ----- Product grid (responsive) ----- */
        .grid {
            display: grid;
            gap: 1.5rem;
            grid-template-columns: 1fr;
        }

        @media (min-width: 600px) {
            .grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (min-width: 1024px) {
            .grid { grid-template-columns: repeat(3, 1fr); }
        }

        /* ----- Product card ----- */
        .card {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.25rem;
            border: 1px solid #e4ecf7;
            box-shadow: 0 4px 12px rgba(0, 20, 60, 0.04);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            display: flex;
            flex-direction: column;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(0, 20, 60, 0.08);
            border-color: #bdd1ea;
        }

        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .card-title {
            font-size: 1rem;
            font-weight: 600;
            color: #0b1d3a;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }

        .pill {
            flex-shrink: 0;
            padding: 0.25rem 0.6rem;
            font-size: 0.7rem;
            font-weight: 600;
            border-radius: 999px;
            text-transform: capitalize;
            white-space: nowrap;
        }
        .pill-fair { background: #e2f4e9; color: #0c6b3a; }
        .pill-overpriced { background: #fdf1e0; color: #a86b1a; }
        .pill-extreme_overpriced { background: #fce6e3; color: #b3261e; }
        .pill-underpriced_good_deal { background: #dcecfb; color: #0d5d8a; }
        .pill-insufficient_data,
        .pill-unknown { background: #edf2f8; color: #5d718c; }

        .card-price {
            margin: 0.5rem 0 0.75rem;
        }
        .card-price .amount {
            font-size: 1.7rem;
            font-weight: 700;
            color: #0b2b6b;
        }
        .card-price .currency {
            font-size: 0.9rem;
            color: #4e6e96;
            margin-left: 0.2rem;
        }

        .card-meta {
            font-size: 0.85rem;
            color: #4e6e96;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            margin-bottom: auto;
        }
        .card-meta .row {
            display: flex;
            gap: 0.4rem;
            align-items: baseline;
            flex-wrap: wrap;
        }
        .card-meta .row strong {
            color: #1a3b6b;
            font-weight: 500;
        }

        .card-category {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            color: #1a4b8c;
            background: #e8effa;
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            margin-top: 0.3rem;
            width: fit-content;
        }

        .card-footer {
            margin-top: 1rem;
            padding-top: 0.8rem;
            border-top: 1px solid #e4ecf7;
        }

        .card-link {
            font-weight: 600;
            font-size: 0.9rem;
            color: #1a4b8c;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }

        .card-link:hover {
            color: #0b2b6b;
            text-decoration: underline;
        }

        .no-link {
            font-size: 0.85rem;
            color: #96abc9;
        }

        /* ----- Footer ----- */
        .footer {
            text-align: center;
            padding: 2rem 0 1.5rem;
            color: #4e6e96;
            font-size: 0.9rem;
            border-top: 1px solid #e4ecf7;
            margin-top: 2.5rem;
        }

        .footer a {
            color: #1a4b8c;
            text-decoration: none;
            font-weight: 600;
        }
        .footer a:hover {
            text-decoration: underline;
        }
        .footer .copyright {
            font-size: 0.8rem;
            color: #7b94b5;
            margin-top: 0.4rem;
        }

        /* ----- Spacing tweaks for tiny screens ----- */
        @media (max-width: 400px) {
            .header h1 { font-size: 1.8rem; }
            .search-card { padding: 1rem; }
            .search-btn { font-size: 0.9rem; padding: 0.7rem 1.2rem; }
            .card { padding: 1rem; }
            .card-price .amount { font-size: 1.4rem; }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- Header -->
    <div class="header">
        <h1>🔍 FairFind</h1>
        <p>AI‑powered price fairness for Ethiopian marketplaces</p>
    </div>

    <!-- Search card -->
    <div class="search-card">
        <form method="GET" action="/" class="search-form">
            <div class="search-field">
                <label for="q">What are you looking for?</label>
                <input type="text" id="q" name="q" value="<%= query %>" placeholder="e.g. serum, Nike shoes, iPhone 13, study desk" autocomplete="off">
            </div>
            <button type="submit" class="search-btn">Search</button>
        </form>
    </div>

    <!-- Results header or empty state -->
    <% if (query.trim()) { %>
        <div class="results-header">
            <h2>Results for <span class="highlight">“<%= query %>”</span></h2>
            <span class="count"><%= products.length %> listing<%= products.length === 1 ? '' : 's' %></span>
        </div>
    <% } else { %>
        <div class="empty-state">
            <div class="icon">🔎</div>
            <p>Enter a search term above to find products with AI fairness scores.</p>
            <p class="hint">Example: “serum”, “shoes”, “phone”</p>
        </div>
    <% } %>

    <!-- No results -->
    <% if (query.trim() && products.length === 0) { %>
        <div class="empty-state">
            <div class="icon">😕</div>
            <p>No listings found for “<%= query %>”.</p>
            <p class="hint">Try a shorter or more general term.</p>
        </div>
    <% } %>

    <!-- Product grid -->
    <div class="grid">
        <% for (var i = 0; i < products.length; i++) {
            var product = products[i]; %>
            <div class="card">
                <div class="card-top">
                    <h3 class="card-title"><%= product.item_name ? product.item_name : 'Unnamed listing' %></h3>
                    <span class="pill pill-<%= product.fairness_status || 'unknown' %>">
                        <%= product.fairness_status ? product.fairness_status.replace(/_/g, ' ') : 'unknown' %>
                    </span>
                </div>

                <div class="card-price">
                    <span class="amount"><%= product.price ? product.price.toLocaleString() : '—' %></span>
                    <span class="currency"><%= product.currency || 'ETB' %></span>
                </div>

                <div class="card-meta">
                    <% if (product.condition) { %>
                        <div class="row"><strong>Condition:</strong> <%= product.condition %></div>
                    <% } %>
                    <% if (product.location) { %>
                        <div class="row"><strong>📍</strong> <%= product.location %></div>
                    <% } %>
                    <% if (product.contact_info) { %>
                        <div class="row"><strong>📞</strong> <%= product.contact_info %></div>
                    <% } %>
                    <% if (product.category) { %>
                        <span class="card-category"><%= product.category %></span>
                    <% } %>
                </div>

                <div class="card-footer">
                    <% if (product.message_url) { %>
                        <a href="<%= product.message_url %>" target="_blank" class="card-link">🔗 View original post →</a>
                    <% } else { %>
                        <span class="no-link">🔗 No link available</span>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>🤖 Try our Telegram bot: <a href="https://t.me/FairFindBot" target="_blank">@FairFindBot</a></p>
        <p class="copyright">© 2026 FairFind – Built with ❤️ for Ethiopian shoppers</p>
    </div>

</div>

</body>
</html>